{
  "name": "@gilbarcoafs/vpos-ftc-app",
  "version": "0.1.19",
  "private": true,
  "main": "start.cjs",
  "engines": {
    "node": ">=22.15.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "dev:forecourt": "tsx server/index.ts",
    "build": "next build && npm run server:gen",
    "start": "node start.cjs -p 3080",
    "start:next": "next start",
    "test": "node scripts/run-tests.mjs",
    "typescript": "npm run typecheck",
    "worker": "tsx scripts/worker.ts",
    "lint": "prettier --write .",
    "fiscal:stub": "tsx scripts/fiscal-worker-stub.ts",
    "server:gen": "esbuild server.ts --bundle --platform=node --format=cjs --target=node22 --outfile=vpos-server.cjs --external:next",
    "proxy-sender-worker": "tsx scripts/proxy-sender-worker.ts",
    "test:jpl-protocol": "node scripts/run-tests.mjs --match tests/runtime/jplProtocol.test.ts",
    "doms:jpl-sim": "tsx scripts/doms-jpl-simulator.ts",
    "doms:jpl-sim:validate": "tsx scripts/doms-jpl-sim-validate.ts",
    "doms:jpl-sim:selftest": "tsx scripts/doms-jpl-sim-selftest.ts",
    "doms:jpl-live:validate": "tsx scripts/doms-jpl-live-validate.ts",
    "doms:jpl-session:selftest": "tsx scripts/doms-jpl-session-selftest.ts",
    "doms:jpl-replay:selftest": "tsx --test tests/forecourt/domsTransactionReplayPolicy.test.ts tests/forecourt/domsReplayConcurrency.test.ts tests/forecourt/domsSingleFlight.test.ts tests/forecourt/domsTransactionBufferNormalization.test.ts",
    "doms:release:evidence": "node scripts/doms-release-evidence.cjs",
    "check:architecture": "npm run check:page-boundaries && npm run check:module-boundaries",
    "fiscal:backfill-events": "tsx scripts/backfill-fiscalization-events.ts",
    "config:storage:audit": "tsx scripts/audit-config-storage.ts",
    "country:catalog:audit": "tsx scripts/audit-country-catalog.ts",
    "config:versions:pin": "tsx scripts/pin-config-version.ts",
    "config:storage:retire": "tsx scripts/retire-config-storage.ts",
    "test:list": "node scripts/run-tests.mjs --list",
    "test:coverage": "node scripts/run-tests.mjs --coverage",
    "test:coverage:services": "node scripts/run-tests.mjs --coverage-profile operational-services",
    "test:coverage:jpl-client": "node scripts/run-tests.mjs --coverage-profile jpl-client",
    "test:coverage:focused": "npm run test:coverage:services && npm run test:coverage:jpl-client && npm run test:coverage:jpl-remaining && npm run test:coverage:jpl-pricing && npm run test:coverage:jpl-status-reads && npm run test:coverage:jpl-orchestration",
    "test:vendor": "node scripts/run-tests.mjs --require-private --match tests/contracts",
    "test:audit": "node scripts/audit-tests.mjs",
    "test:ci": "node scripts/run-tests.mjs --require-private",
    "test:coverage:jpl-remaining": "node scripts/run-tests.mjs --coverage-profile jpl-remaining-commands",
    "test:coverage:jpl-pricing": "node scripts/run-tests.mjs --coverage-profile jpl-pricing",
    "test:coverage:jpl-status-reads": "node scripts/run-tests.mjs --coverage-profile jpl-status-reads",
    "test:coverage:jpl-orchestration": "node scripts/run-tests.mjs --coverage-profile jpl-orchestration",
    "typecheck": "tsc --noEmit",
    "check:hygiene": "node scripts/check-repository-hygiene.mjs",
    "check:docs": "node scripts/check-docs-consistency.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:architecture && npm run check:hygiene && npm run check:docs && npm test",
    "agent:manifest": "node scripts/generate-agent-manifest.mjs",
    "agent:find": "node scripts/agent-context.mjs find",
    "agent:deps": "node scripts/agent-context.mjs deps",
    "agent:impact": "node scripts/agent-context.mjs impact",
    "agent:tests": "node scripts/agent-context.mjs tests",
    "check:page-boundaries": "node scripts/check-page-boundaries.mjs",
    "check:module-boundaries": "node scripts/check-module-boundaries.mjs"
  },
  "dependencies": {
    "@gilbarcoafs/doms-pos-jpl": "^1.1.16",
    "@gilbarcoafs/vpos-common": "^0.0.28",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-slot": "1.1.1",
    "@xmldom/xmldom": "^0.8.10",
    "archiver": "^7.0.1",
    "dotenv": "^16.4.7",
    "lucide-react": "^0.454.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "node-cron": "^4.2.1",
    "pg": "8.17.1",
    "pngjs": "5.0.0",
    "qrcode": "^1.5.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "supports-color": "8.1.1",
    "tailwindcss-animate": "^1.0.7",
    "web-push": "^3.6.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@types/archiver": "^7.0.0",
    "@types/node": "22.15.33",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.23",
    "esbuild": "^0.27.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.8.1",
    "typescript": "^5"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "packageManager": "npm@10.9.2"
}
